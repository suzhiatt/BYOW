{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile BYOW",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh compile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Run BYOW",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
